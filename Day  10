delimiter $$
  
create trigger after_orders_insert
after insert on order_1
for each row
begin
insert into history_3(order_id,cus_name,order_date,total_amount,timestamp) 
values (new.order_id,new.cus_name,new.order_date,new.total_amount,now());
end $$

